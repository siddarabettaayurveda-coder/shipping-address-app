
name: Build Shipping APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Extract project
        run: unzip -q ShippingAddressApp_Android_Project.zip -d source
      - name: Build APK
        run: gradle -p source/ShippingAddressApp :app:assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: ShippingAddress-APK
          path: source/ShippingAddressApp/app/build/outputs/apk/debug/app-debug.apk
